---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../utils/posts';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Notes on what I'm building and learning.">
  <h1>Blog</h1>
  <p class="lead">Short notes on what I'm building and learning.</p>

  <section class="section">
    {posts.map((post) => <PostCard post={post} />)}
    {posts.length === 0 && <p class="muted">No posts yet. Add a Markdown file to src/content/blog.</p>}
  </section>
</BaseLayout>
