---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <h1>Page not found</h1>
  <p class="lead">That page doesn't exist or has moved. Try the home page or the blog.</p>
  <div class="actions">
    <a class="btn btn-primary" href="/">Go home</a>
    <a class="btn" href="/blog">Open the blog</a>
  </div>
</BaseLayout>
