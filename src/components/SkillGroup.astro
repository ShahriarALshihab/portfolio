---
import type { SkillGroup } from '../data/skills';

interface Props {
  group: SkillGroup;
}

const { group } = Astro.props;
---

<section class="group">
  <h3>{group.title}</h3>
  <p class="muted">{group.blurb}</p>
  <ul>
    {group.items.map((item) => <li>{item}</li>)}
  </ul>
</section>

<style>
  .group {
    margin-bottom: 2rem;
  }
  h3 {
    margin-bottom: 0.1rem;
  }
  p {
    margin-bottom: 0.75rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-weight: 500;
  }
</style>
